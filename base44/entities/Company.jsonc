{
  "name": "Company",
  "type": "object",
  "properties": {
    "tenant_id": {
      "type": "string"
    },
    "company_name": {
      "type": "string"
    },
    "vat_id": {
      "type": "string"
    },
    "address_line1": {
      "type": "string"
    },
    "city": {
      "type": "string"
    },
    "zip": {
      "type": "string"
    },
    "country_code": {
      "type": "string"
    },
    "contact_email": {
      "type": "string"
    },
    "contact_phone": {
      "type": "string"
    },
    "payment_terms_days": {
      "type": "number",
      "default": 0
    },
    "notes": {
      "type": "string"
    },
    "total_bookings": {
      "type": "number",
      "default": 0
    },
    "total_revenue": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "tenant_id",
    "company_name"
  ]
}